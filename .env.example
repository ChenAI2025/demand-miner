# ===== Product Hunt（必填，免费） =====
# 申请地址：https://www.producthunt.com/v2/oauth/applications
# 新建一个 Application，页面底部的 "Developer Token" 即为该值
PH_API_TOKEN=

# ===== SimilarWeb（可选，补齐流量/关键词验证层） =====
# 注册 https://similarweb.com 后在开发者后台拿 API Key
# 不填也能跑：需求词照常产出，只是没有流量/关键词 enrichment
SIMILARWEB_API_KEY=

# ===== AITDK（预留，暂未开放公开 API） =====
# AITDK 数据底层来自 SimilarWeb，填了 SIMILARWEB_API_KEY 即等效。
# 若将来 AITDK 开放接口，在 src/enrich.py 的 AITDKEnricher 中接入即可。
AITDK_API_KEY=

# ===== 运行参数（可选） =====
# 每次最多处理的 ProductHunt 产品数（按票数排序截取，控制 API 用量）
MAX_PRODUCTS=60
# 仅对票数最高的前 N 个产品做 SimilarWeb 流量 enrichment（控制配额）
ENRICH_TOP_N=20
